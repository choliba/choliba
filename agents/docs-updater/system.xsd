<?xml version="1.0" encoding="UTF-8"?>
<!--
  The docs-updater's own schema: the base Agent type (packages/agents/schemes/agent-types.xsd, loaded
  under the name agent-types.xsd) with docs_map required, since it maps each change in the diff to the
  doc it affects.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:include schemaLocation="agent-types.xsd"/>

  <xs:complexType name="DocsUpdaterAgent">
    <xs:complexContent>
      <xs:restriction base="Agent">
        <xs:sequence>
          <xs:element name="system_role" type="xs:string"/>
          <xs:element name="permissions" type="Permissions"/>
          <xs:element name="tool_definitions" type="ToolDefinitions"/>
          <xs:element name="input_contract" type="xs:string"/>
          <xs:element name="docs_map" type="xs:string"/>
          <xs:element name="execution_flow" type="xs:string"/>
          <xs:element name="output_contract" type="xs:string"/>
        </xs:sequence>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="agent" type="DocsUpdaterAgent"/>

</xs:schema>
