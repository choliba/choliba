<?xml version="1.0" encoding="UTF-8"?>
<!--
  Types of an agent's system.md, included by agent.xsd. Loaded under the name agent-types.xsd.
  What the agent may read, write and run is not here: it is agent.yaml#permissions, which the
  command enforces and writes into the prompt itself.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="Notes">
    <xs:sequence>
      <xs:element name="note" type="xs:string" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Preparation">
    <xs:sequence>
      <xs:element name="item" type="xs:string" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ToolDefinitions">
    <xs:sequence>
      <xs:element name="intro" type="xs:string"/>
      <xs:element name="preparation" type="Preparation"/>
      <xs:element name="notes" type="Notes"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    The sections of an agent's system.md, in order. docs_map is optional: it only means something to
    an agent that maps changes to docs (the docs-updater).
  -->
  <xs:complexType name="Agent">
    <xs:sequence>
      <xs:element name="system_role" type="xs:string"/>
      <xs:element name="tool_definitions" type="ToolDefinitions"/>
      <xs:element name="input_contract" type="xs:string"/>
      <xs:element name="docs_map" type="xs:string" minOccurs="0"/>
      <xs:element name="execution_flow" type="xs:string"/>
      <xs:element name="output_contract" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
