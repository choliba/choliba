{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://choliba.internal/schemas/agent.yaml.schema.json",
  "title": "agent.yaml",
  "description": "Metadados de um agente em agents/<nome>/agent.yaml — validado por validateAgentYaml em packages/agents/src/agent-validation.ts.",
  "type": "object",
  "required": ["id", "name", "version", "description", "supported_models"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "supported_models": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ticket_types": {
      "type": "array",
      "description": "Tipos de ticket com que o agente trabalha (templates em packages/projects/templates/ticket/). Com isto, a execução exige --type <tipo> (o CLI cria o ticket a partir do template) ou --ticket <chave>; pede project_required: true.",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mcps": {
      "description": "Servidores MCP que o agente pode usar, pelo nome de .agents/mcps/<nome>.json (ou CHOL_MCPS_DIR). O agente não recebe nenhum outro. Lista de nomes (todas as tools de cada um) ou mapa nome -> { tools: [...] } (só essas tools).",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "tools": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "policy": {
      "type": "string",
      "enum": ["read-only", "edits", "full"],
      "description": "Opcional: sem ele, o nível vem do <permissions> do system.md (algum caminho de escrita = edits, senão read-only)."
    },
    "task_required": {
      "type": "boolean"
    },
    "project_required": {
      "type": "boolean",
      "description": "O agente age sob um projeto: --project <nome> é obrigatório e o projects valida o projeto antes de chamar o modelo. Libera ${PROJECT} e ${PROJECT_DIR} no system.md."
    },
    "default_task": {
      "type": "string",
      "description": "Tarefa usada quando o usuário não passa nenhuma (com task_required: false)."
    },
    "default_mode": {
      "type": "string",
      "enum": ["execute", "plan", "ask"]
    },
    "before_execute": {
      "description": "Ações rodadas pelo CLI antes de chamar o modelo, em ordem: <ação>: [args]. Podem acrescentar seções ao prompt.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/beforeStep"
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "diff_file", "since_pending_state"],
      "properties": {
        "kind": {
          "const": "working_tree_diff"
        },
        "diff_file": {
          "type": "string",
          "minLength": 1
        },
        "default_base": {
          "type": "string",
          "minLength": 1
        },
        "since_pending_state": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "docs": {
              "type": "boolean"
            },
            "readme": {
              "type": "boolean"
            }
          }
        },
        "default_task": {
          "type": "string"
        }
      },
      "description": "Formato antigo, ainda aceito: vira git_diff + add_files em before_execute. Use before_execute."
    },
    "after_execute": {
      "description": "Ações rodadas pelo CLI depois de um execute bem-sucedido, em ordem: <ação>: [args]. Ainda aceita o formato antigo: texto (pelo shell) ou lista (sem shell), com método interno na primeira palavra.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/afterStep"
      }
    }
  },
  "definitions": {
    "beforeStep": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "run": {
              "description": "Comando externo, sem shell: [programa, args...].",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "git_diff": {
              "description": "[<base>, <arquivo>] ou [<base>, <arquivo>, --pending, <estado>]: grava o diff da base (ou --since) até a working tree e o indexa no prompt.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 4
            },
            "add_files": {
              "description": "[<tag>, <glob...>]: os arquivos, no prompt entre <tag> e </tag>.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2
            }
          }
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "afterStep": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "run": {
              "description": "Comando externo, sem shell: [programa, args...].",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "record_git_head": {
              "description": "[<arquivo>]: grava o HEAD atual (lido pelo --pending do git_diff).",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  }
}
