<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:include schemaLocation="agent-types.xsd"/>

  <!--
    Root element every agent's system.md must have exactly one of, wrapping the whole document
    (see agents/docs-updater/system.md) — required because plain XML has no notion of multiple
    top-level elements; everything the agent's prompt says has to live under this one root.
    This is the default schema, for agents without their own agents/<name>/system.xsd.
  -->
  <xs:element name="agent" type="Agent"/>

</xs:schema>
