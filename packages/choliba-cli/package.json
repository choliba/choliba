{
  "name": "choliba-cli",
  "version": "0.0.1-dev",
  "description": "Assistente para começar com o choliba: cria a pasta de trabalho, instala o choliba e os agentes.",
  "private": true,
  "type": "module",
  "bin": {
    "choliba-cli": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@choliba/core": "workspace:*",
    "@choliba/terminal": "workspace:*",
    "@clack/prompts": "^1.8.1",
    "@nestjs/common": "~11.2",
    "@nestjs/core": "~11.2",
    "nest-commander": "~3.21",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@choliba/agents": "workspace:*",
    "@nestjs/testing": "~11.2",
    "nest-commander-testing": "~3.6"
  }
}
