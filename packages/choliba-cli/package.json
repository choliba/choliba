{
  "name": "choliba-cli",
  "version": "0.0.1-dev",
  "description": "O choliba da m\u00e1quina: cria a pasta de trabalho, gera agentes, projetos e tickets e instala agentes, skills e MCPs; dentro de uma pasta de trabalho, repassa o resto para o choliba dela.",
  "private": true,
  "type": "module",
  "bin": {
    "choliba": "./src/main.ts",
    "chol": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@choliba/agents": "workspace:*",
    "@choliba/core": "workspace:*",
    "@choliba/projects": "workspace:*",
    "@choliba/terminal": "workspace:*",
    "@clack/prompts": "^1.8.1",
    "@nestjs/common": "~11.2",
    "@nestjs/core": "~11.2",
    "nest-commander": "~3.21",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "~11.2",
    "nest-commander-testing": "~3.6"
  }
}
