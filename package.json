{
  "name": "choliba",
  "version": "0.3.0",
  "description": "Roda agentes de código (Claude Code, Codex, Cursor, Ollama) em sandbox, com uma política só e rodadas que os comparam.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "exports": {
    ".": "./src/index.ts",
    "./rounds": "./src/rounds/index.ts",
    "./config": "./src/config/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "choliba": "./bin/choliba.ts"
  },
  "files": [
    "src",
    "bin",
    "src/rounds/web/dist",
    "README.md",
    "LICENSE",
    "!src/rounds/web/node_modules",
    "!src/rounds/web/src",
    "!src/rounds/web/bun.lock"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "ollama:codex": "bun guides/agent/exemplos/7-entradas-e-saidas.ts",
    "ollama": "bun guides/agent/exemplos/7-ollama.ts",
    "tui": "bun guides/agent/exemplos/7-tui.ts",
    "rounds": "bun bin/choliba.ts rounds",
    "rounds:web": "bun bin/choliba.ts rounds:web",
    "rounds:build": "bun run --cwd src/rounds/web build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/rounds/web",
    "lint": "oxlint --type-aware src bin test tools scripts guides config choliba.config.ts",
    "lint:fix": "oxlint --type-aware --fix src bin test tools scripts guides config choliba.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test:cov",
    "approvals": "bun src/cli/approvals.ts",
    "issue": "bun scripts/issue.ts",
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "git:clean": "bun scripts/git-clean.ts",
    "release:notes": "bun scripts/release-notes.ts",
    "docs:pages": "bun scripts/docs-pages.ts",
    "docs:dev": "bun run docs:pages && vitepress dev docs",
    "docs:build": "bun run docs:pages && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "clear": "bun src/cli/clear.ts",
    "test": "bun test test/",
    "test:cov": "bun test test/ --coverage && bun scripts/coverage-ratchet.ts",
    "choliba": "bun bin/choliba.ts",
    "prepack": "bun run rounds:build"
  },
  "devDependencies": {
    "@elastic/ecs-pino-format": "^1.5.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "pino": "^10.4.0",
    "prettier": "3.9.10",
    "puppeteer": "^25.17.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0"
  }
}
