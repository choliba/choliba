{
  "name": "@choliba/monorepo",
  "private": true,
  "license": "MIT",
  "author": "Jackson Bicalho",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "jest --config jest/jest.config.ts",
    "test:watch": "jest --config jest/jest.config.ts --watch",
    "test:cov": "jest --coverage --config jest/jest.config.ts",
    "check": "bun run typecheck && bun run lint && bun run format && bun run test:cov",
    "prepare": "git config core.hooksPath .githooks || true",
    "chol:agents": "bun packages/choliba/src/main.ts agents",
    "chol:docs": "bun chol:agents --docs-updater",
    "chol:po": "bun chol:agents --product-owner",
    "chol:test-writer": "bun chol:agents --test-writer",
    "chol:implementer": "bun chol:agents --implementer",
    "chol:projects": "bun packages/choliba/src/main.ts projects",
    "chol:project:list": "bun run chol:projects list",
    "chol:tests": "bun packages/choliba/src/main.ts tests",
    "chol:help": "bun run scripts/help.ts",
    "chol:pack": "bun run --cwd packages/choliba build && cd packages/choliba/dist && bun pm pack --destination ..",
    "git:clean": "bun run scripts/git-clean.ts",
    "bench:startup": "bun run scripts/bench-startup.ts",
    "release:notes": "bun run scripts/release-notes.ts",
    "docs:dev": "bun run docs:home && vitepress dev docs",
    "docs:build": "bun run docs:home && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:home": "bun scripts/docs-home.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/jest": "30.0.0",
    "@types/node": "^22.19.6",
    "choliba": "workspace:*",
    "esbuild": "^0.28.2",
    "esbuild-register": "^3.6.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "jest": "30.5.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.8",
    "ts-jest": "29.4.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitepress": "^1.6.4"
  }
}
