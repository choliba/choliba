# Optional: default provider when --provider is not passed (auto | claude | cursor; default: auto).
# A explicit --provider flag on the CLI overrides this value.
# CHOL_AGENTS_PROVIDER=auto

# Optional: where the agents, skills and MCPs are (default: .choliba/agents, .choliba/skills and .choliba/mcps,
# where this repository keeps them too). A relative path is resolved from the workspace root.
# CHOL_AGENTS_DIR=.choliba/agents
# CHOL_SKILLS_DIR=.choliba/skills
# CHOL_MCPS_DIR=.choliba/mcps

# Playwright multi-project: external workspace root (required to run E2E).
# Projects default to {CHOL_GLOBAL_DIR}/projects unless CHOL_PROJECTS_DIR is set.
CHOL_GLOBAL_DIR=

# Optional: override where projects live (config.json, tests/, tickets/).
# CHOL_PROJECTS_DIR=

# Optional: shared ticket-runs/ root (default: CHOL_PROJECTS_DIR).
# CHOL_TICKET_RUNS=

# Optional: where mcp-app (https://github.com/jacksonbicalho/mcp-app) is installed and built, for agents
# that list it in agent.yaml#mcps (.choliba/mcps/mcp-app.json). Its credentials stay in its own environments.json.
# CHOL_MCP_APP_DIR=
# Where mcp-app writes its logs (the LOG_DIR that .choliba/mcps/mcp-app.json passes to it). A relative path is
# resolved from the folder the provider starts the server in, so prefer an absolute one.
# CHOL_MCP_APP_LOG_DIR=

# Optional: where `choliba playwright-cli` writes snapshots and screenshots (read by the product-owner agent,
# whose agent.yaml allows reading .cache/playwright-cli/; default: .cache/playwright-cli).
# CHOL_PLAYWRIGHT_MCP_OUTPUT_DIR=.cache/playwright-cli
# Opcional: as cores do choliba, papel.nome=cor separados por vírgula (ex.: agents.test-writer=bright-red).
# Cores: red, green, yellow, blue, magenta, cyan, white, gray e os tons claros bright-red, bright-green,
# bright-yellow, bright-blue, bright-magenta e bright-cyan; o tom exato depende do tema do terminal. A cor só
# aparece no terminal: sai sem cor com --no-color, NO_COLOR=1, TERM=dumb ou em pipe (FORCE_COLOR=1 força).
# Só muda o que estiver na linha; o resto fica no padrão. Os padrões:
#   providers.claude=magenta
#   providers.cursor=cyan
#   agents.product-owner=blue
#   agents.test-writer=red
#   agents.implementer=green
#   agents.docs-updater=cyan
#   states.error=bright-red
#   states.success=green
#   states.warning=yellow
#   states.hint=gray
#   gates.red=red
#   gates.green=green
#   labels.provider=magenta
# Para mudar, tire o # da linha abaixo e escreva as cores que quer trocar, por exemplo:
# CHOL_COLORS=agents.test-writer=bright-red,states.error=red
