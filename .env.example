# Default provider when --provider is not passed (auto | claude | cursor).
# A explicit --provider flag on the CLI overrides this value.
CHOL_AGENTS_PROVIDER=auto

# Playwright multi-project: external workspace root (required to run E2E).
# Projects default to {GLOBAL_DIR}/projects unless PROJECTS_DIR is set.
GLOBAL_DIR=

# Optional: override where projects live (config.json, tests/, tickets/).
# PROJECTS_DIR=

# Optional: shared ticket-runs/ root (default: PROJECTS_DIR).
# TICKET_RUNS=

# Optional: where mcp-app (https://github.com/jacksonbicalho/mcp-app) is installed and built, for agents
# that list it in agent.yaml#mcps (.agents/mcps/mcp-app.json). Its credentials stay in its own environments.json.
# MCP_APP_DIR=
# Where mcp-app writes its logs (the LOG_DIR of .agents/mcps/mcp-app.json). A relative path is resolved
# from the choliba root, where the provider starts the server, e.g. .cache/mcp-app/logs.
# LOG_DIR=

# Where `bun run chol:playwright-cli` writes snapshots and screenshots (read by the product-owner agent,
# whose system.md allows reading .cache/playwright-cli/). Without it, the CLI writes to .playwright-cli/.
PLAYWRIGHT_MCP_OUTPUT_DIR=.cache/playwright-cli
