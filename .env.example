# Variáveis do Choliba. Copie para .env e preencha: o Bun carrega o .env
# sozinho. Todas levam o prefixo CHOLIBA_.

# Debug: 1 (ou true) liga o debug e o log em nível debug.
CHOLIBA_DEBUG=

# Credenciais dos CLIs. O choliba.config.ts as entrega a cada CLI com o nome
# que ele lê (CURSOR_API_KEY, CLAUDE_CODE_OAUTH_TOKEN).
CHOLIBA_CURSOR_API_KEY=
CHOLIBA_CLAUDE_CODE_OAUTH_TOKEN=

# As pastas das rodadas. Vazias, a config carrega igual, e só os comandos das
# rodadas (bun run rounds, rounds:web, clear --rounds) param, dizendo o que
# falta. CHOLIBA_ROUNDS_DIR é onde as rodadas rodam: fora do projeto, como
# ~/.local/share/choliba/rodadas.
CHOLIBA_ROUNDS_DIR=
CHOLIBA_ROUNDS_DEFINITIONS=
CHOLIBA_ROUNDS_FIXTURES=
CHOLIBA_ROUNDS_DATA=
