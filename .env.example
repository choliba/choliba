# Environment for developing choliba in this repository (the repository is a workspace too). Copy it to .env.
# The template a new workspace gets is packages/choliba/templates/workspace/env; every variable is described in
# docs/referencia/env.md.

# Where test runs keep their artifacts and, without CHOL_PROJECTS_DIR, the test projects
# ({CHOL_GLOBAL_DIR}/projects). Use an absolute path.
CHOL_GLOBAL_DIR=

# Optional: where the test projects live (config.json, tests/, tickets/), instead of {CHOL_GLOBAL_DIR}/projects.
# CHOL_PROJECTS_DIR=

# Optional: root of ticket-runs/ (default: CHOL_PROJECTS_DIR).
# CHOL_TICKET_RUNS=

# Optional: where the agents, skills and MCPs are (default: .choliba/agents, .choliba/skills and .choliba/mcps,
# where this repository keeps them too). A relative path is resolved from the workspace root.
# CHOL_AGENTS_DIR=.choliba/agents
# CHOL_SKILLS_DIR=.choliba/skills
# CHOL_MCPS_DIR=.choliba/mcps

# Optional: default provider when --provider is not passed (auto | claude | cursor; default: auto).
# An explicit --provider flag on the CLI overrides this value.
# CHOL_AGENTS_PROVIDER=auto

# Optional: where the agents' playwright-cli run tool writes snapshots and screenshots (read by the product-owner
# agent, whose agent.yaml allows reading .cache/playwright-cli/; default: .cache/playwright-cli).
# CHOL_PLAYWRIGHT_MCP_OUTPUT_DIR=.cache/playwright-cli

# MCPs: each ${NAME} in .choliba/mcps/*.json comes from here. mcp-app (https://github.com/jacksonbicalho/mcp-app)
# needs the folder where it is cloned and built, and the folder for its logs (the LOG_DIR that mcp-app.json passes
# to it; a relative path is resolved from where the provider starts the server, so prefer absolute paths). Its
# credentials stay in its own environments.json.
# CHOL_MCP_APP_DIR=
# CHOL_MCP_APP_LOG_DIR=

# Optional: choliba's colors, role.name=color separated by commas (e.g. agents.test-writer=bright-red). The
# roles, colors and defaults are listed in packages/choliba/templates/workspace/env.
# CHOL_COLORS=agents.test-writer=bright-red,states.error=red
