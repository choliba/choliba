# Optional: default provider when --provider is not passed (auto | claude | cursor; default: auto).
# A explicit --provider flag on the CLI overrides this value.
# CHOL_AGENTS_PROVIDER=auto

# Required here: this repository keeps its agents, skills and MCPs at the root, not under app/ (the default of
# a workspace made by `choliba setup`), so it says where they are.
CHOL_AGENTS_DIR=agents
CHOL_SKILLS_DIR=.agents/skills
CHOL_MCPS_DIR=.agents/mcps

# Playwright multi-project: external workspace root (required to run E2E).
# Projects default to {CHOL_GLOBAL_DIR}/projects unless PROJECTS_DIR is set.
CHOL_GLOBAL_DIR=

# Optional: override where projects live (config.json, tests/, tickets/).
# PROJECTS_DIR=

# Optional: shared ticket-runs/ root (default: PROJECTS_DIR).
# TICKET_RUNS=

# Optional: where mcp-app (https://github.com/jacksonbicalho/mcp-app) is installed and built, for agents
# that list it in agent.yaml#mcps (.agents/mcps/mcp-app.json). Its credentials stay in its own environments.json.
# MCP_APP_DIR=
# Where mcp-app writes its logs (the LOG_DIR that .agents/mcps/mcp-app.json passes to it). A relative path is
# resolved from the folder the provider starts the server in, so prefer an absolute one.
# MCP_APP_LOG_DIR=

# Optional: where `choliba playwright-cli` writes snapshots and screenshots (read by the product-owner agent,
# whose agent.yaml allows reading .cache/playwright-cli/; default: .cache/playwright-cli).
# PLAYWRIGHT_MCP_OUTPUT_DIR=.cache/playwright-cli
